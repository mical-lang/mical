```
SourceFile {
    items: [
        Entry {
            key: WordKey {
                word: WORD@0..1 "a",
            },
            value: Integer {
                sign: none,
                numeral: NUMERAL@2..3 "1",
            },
        },
        Entry {
            key: WordKey {
                word: WORD@5..6 "b",
            },
            value: Integer {
                sign: none,
                numeral: NUMERAL@7..8 "2",
            },
        },
        Entry {
            key: WordKey {
                word: WORD@13..14 "c",
            },
            value: Integer {
                sign: none,
                numeral: NUMERAL@15..16 "3",
            },
