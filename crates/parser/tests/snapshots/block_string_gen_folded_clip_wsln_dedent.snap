      LINE_STRING@14..14
      NEWLINE@14..15 "\n"
      SPACE@15..17 "  "
      LINE_STRING@17..18
        STRING@17..18 "b"
      NEWLINE@18..19 "\n"
  ENTRY@19..30
    WORD_KEY@19..22
      WORD@19..22 "end"
    SPACE@22..23 " "
    LINE_STRING@23..29
      STRING@23..29 "marker"
    NEWLINE@29..30 "\n"
```

