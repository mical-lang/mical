    WORD_KEY@0..3
      WORD@0..3 "a#b"
    SPACE@3..8 "     "
    LINE_STRING@8..13
      STRING@8..13 "value"
    NEWLINE@13..14 "\n"
  ENTRY@14..28
    WORD_KEY@14..19
      WORD@14..19 "can't"
    SPACE@19..22 "   "
    LINE_STRING@22..27
      STRING@22..27 "value"
    NEWLINE@27..28 "\n"
  ENTRY@28..42
    WORD_KEY@28..32
      WORD@28..32 ".dot"
    SPACE@32..36 "    "
    LINE_STRING@36..41
